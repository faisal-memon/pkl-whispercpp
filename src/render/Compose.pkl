/// Render the Compose settings as Docker Compose YAML.
module whispercpp.ComposeRender

import "../Compose.pkl"

config: Compose = new Compose {}

local imageReference = "\(config.imageRepository):\(config.version)@\(config.imageDigest)"
local modelPath = "\(config.modelMountPath)/ggml-\(config.settings.model).bin"
local downloaderCommand =
  "if [ ! -s \"\(modelPath)\" ]; then "
  + "./models/download-ggml-model.sh \"\(config.settings.model)\" \"\(config.modelMountPath)\"; "
  + "fi"

output {
  value = new Dynamic {
    services {
      model_init {
        image = imageReference
        restart = "no"
        command = new Listing { "sh"; "-c"; downloaderCommand }
        volumes = new Listing { "\(config.modelDirectory):\(config.modelMountPath)" }
      }
      [config.containerName] = new Dynamic {
        image = imageReference
        command = new Listing {
          "whisper-server"
          "--host"; "0.0.0.0"
          "--port"; "\(config.settings.port)"
          "--model"; modelPath
          "--language"; config.settings.language
          "--inference-path"; config.settings.inferencePath
          when (config.settings.convertAudio) { "--convert" }
          when (config.settings.flashAttention) { "--flash-attn" }
        }
        restart = config.restartPolicy
        depends_on { model_init { condition = "service_completed_successfully" } }
        ports = if (config.publishHostPort) new Listing { "\(config.hostIp):\(config.settings.port):\(config.settings.port)" } else null
        networks = if (config.externalNetworkName != null) new Listing { config.externalNetworkName } else null
        volumes = new Listing { "\(config.modelDirectory):\(config.modelMountPath):ro" }
        deploy {
          resources {
            reservations {
              devices = new Listing {
                new Dynamic { driver = "nvidia"; count = config.gpuCount; capabilities = new Listing { "gpu" } }
              }
            }
          }
        }
      }
    }
    when (config.externalNetworkName != null) {
      networks {
        [config.externalNetworkName] = new Dynamic { ["external"] = true }
      }
    }
  }
  renderer = new YamlRenderer {}
}
