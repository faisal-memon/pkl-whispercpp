/// Render the Compose settings as Docker Compose YAML.
module whispercpp.ComposeRender

import "../Compose.pkl"

config: Compose = new Compose {}

local dockerCompose = config.dockerCompose
local imageReference = "\(dockerCompose.imageRepository):\(dockerCompose.version)@\(dockerCompose.imageDigest)"
local modelPath = "\(dockerCompose.modelMountPath)/ggml-\(dockerCompose.settings.model).bin"
local downloaderCommand =
  "if [ ! -s \"\(modelPath)\" ]; then "
  + "./models/download-ggml-model.sh \"\(dockerCompose.settings.model)\" \"\(dockerCompose.modelMountPath)\"; "
  + "fi"

output {
  value = new Dynamic {
    services {
      model_init {
        image = imageReference
        restart = "no"
        command = new Listing { "sh"; "-c"; downloaderCommand }
        volumes = new Listing { "\(dockerCompose.modelDirectory):\(dockerCompose.modelMountPath)" }
      }
      [dockerCompose.containerName] = new Dynamic {
        image = imageReference
        command = new Listing {
          "whisper-server"
          "--host"; "0.0.0.0"
          "--port"; "\(dockerCompose.settings.port)"
          "--model"; modelPath
          "--language"; dockerCompose.settings.language
          "--inference-path"; dockerCompose.settings.inferencePath
          when (dockerCompose.settings.convertAudio) { "--convert" }
          when (dockerCompose.settings.flashAttention) { "--flash-attn" }
        }
        restart = dockerCompose.restartPolicy
        depends_on { model_init { condition = "service_completed_successfully" } }
        ports = if (dockerCompose.publishHostPort) new Listing { "\(dockerCompose.hostIp):\(dockerCompose.settings.port):\(dockerCompose.settings.port)" } else null
        networks = if (dockerCompose.externalNetworkName != null) new Listing { dockerCompose.externalNetworkName } else null
        volumes = new Listing { "\(dockerCompose.modelDirectory):\(dockerCompose.modelMountPath):ro" }
        deploy {
          resources {
            reservations {
              devices = new Listing {
                new Dynamic { driver = "nvidia"; count = dockerCompose.gpuCount; capabilities = new Listing { "gpu" } }
              }
            }
          }
        }
      }
    }
    when (dockerCompose.externalNetworkName != null) {
      networks {
        [dockerCompose.externalNetworkName] = new Dynamic { ["external"] = true }
      }
    }
  }
  renderer = new YamlRenderer {}
}
