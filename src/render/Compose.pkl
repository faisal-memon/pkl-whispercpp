/// Render a CUDA-enabled whisper.cpp service as Docker Compose.
module whispercpp.Compose

import "../Whispercpp.pkl"

/// Application settings passed to whisper.cpp itself.
settings: Whispercpp = new Whispercpp {}

/// Docker deployment settings.
/// Renovate updates the official CUDA image digest as upstream publishes builds.
imageRepository: String(!isEmpty) = "ghcr.io/ggml-org/whisper.cpp"
version: String(!isEmpty) = "main-cuda"
imageDigest: String(matches(Regex("sha256:[a-f0-9]{64}"))) = "sha256:8a9def3eea0615dbee85cac1e0fa3898dce214fe9bb7955635ba25667da3884a"
containerName: String(!isEmpty) = "whispercpp"
restartPolicy: String(!isEmpty) = "unless-stopped"
/// Host directory where the downloaded model is retained across restarts.
modelDirectory: String(startsWith("/"), !contains("\n"), !contains("$"))
/// Container path for the model cache.
modelMountPath: String(startsWith("/"), !contains("\n"), !contains("$")) = "/models"
/// Bind to loopback unless another service must reach transcription over the network.
hostIp: String(!isEmpty) = "127.0.0.1"
/// Publish the transcription port on the host. Disable this when callers use a shared Docker network.
publishHostPort: Boolean = true
/// Optional pre-existing Docker network for internal callers.
externalNetworkName: String? = null
gpuCount: Int(isBetween(1, 64)) = 1

local imageReference = "\(imageRepository):\(version)@\(imageDigest)"
local modelPath = "\(modelMountPath)/ggml-\(settings.model).bin"
local downloaderCommand =
  "if [ ! -s \"\(modelPath)\" ]; then "
  + "./models/download-ggml-model.sh \"\(settings.model)\" \"\(modelMountPath)\"; "
  + "fi"

output {
  value = new Dynamic {
    services {
      model_init {
        image = imageReference
        restart = "no"
        command = new Listing { "sh"; "-c"; downloaderCommand }
        volumes = new Listing { "\(modelDirectory):\(modelMountPath)" }
      }
      [containerName] = new Dynamic {
        image = imageReference
        command = new Listing {
          "whisper-server"
          "--host"; "0.0.0.0"
          "--port"; "\(settings.port)"
          "--model"; modelPath
          "--language"; settings.language
          "--inference-path"; settings.inferencePath
          when (settings.convertAudio) { "--convert" }
          when (settings.flashAttention) { "--flash-attn" }
        }
        restart = restartPolicy
        depends_on { model_init { condition = "service_completed_successfully" } }
        ports = if (publishHostPort) new Listing { "\(hostIp):\(settings.port):\(settings.port)" } else null
        networks = if (externalNetworkName != null) new Listing { externalNetworkName } else null
        volumes = new Listing { "\(modelDirectory):\(modelMountPath):ro" }
        deploy {
          resources {
            reservations {
              devices = new Listing {
                new Dynamic { driver = "nvidia"; count = gpuCount; capabilities = new Listing { "gpu" } }
              }
            }
          }
        }
      }
    }
    when (externalNetworkName != null) {
      networks {
        [externalNetworkName] = new Dynamic { ["external"] = true }
      }
    }
  }
  renderer = new YamlRenderer {}
}
