/// Example whisper.cpp deployment for an NVIDIA GPU host.
amends "../src/render/DockerCompose.pkl"

import "../src/Whispercpp.pkl"
import "../src/DockerCompose.pkl"

config {
  whispercpp = new Whispercpp {
    model = "medium"
    port = 8080
    language = "en"
  }
  hostModelDirectory = "/var/lib/whispercpp/models"
  hostPublishing = new DockerCompose.HostPublishing {}
}
