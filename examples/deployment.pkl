/// Example whisper.cpp deployment for an NVIDIA GPU host.
amends "../src/render/Compose.pkl"

import "../src/Whispercpp.pkl"

config {
  dockerCompose {
    settings = new Whispercpp {
      model = "medium"
      port = 8080
      language = "en"
    }
    modelDirectory = "/var/lib/whispercpp/models"
    hostIp = "127.0.0.1"
  }
}
