{
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src\\/Whispercpp\\.pkl$/"],
      "matchStrings": [
        "image: String\\(!isEmpty\\) = \\\"(?<depName>[^:\\\"]+):(?<currentValue>[^@\\\"]+)@(?<currentDigest>sha256:[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
